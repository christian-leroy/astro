---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "About Me";
const identity = {
    firstName: "Hans-Werner",
    country: "Bundesrepublik Deutschland",
    occupation: "Mind your business",
    hobbies: ["photography", "birdwatching", "watching the neighbors"]
}

const skills = ["drinking Bier", "following the rules",  "complaining"]
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
        <style define:vars={{skillColor, fontWeight, textCase}}>
        h1 
        {
        color: purple;
        font-size: 4rem;
        }
        .skill 
        {
        color: var(--skillColor);
            font-weight: var(--fontWeight);
    text-transform: var(--textCase);
        }
    </style>
	</head>
	<body>
    <!-- This just uses the entire HTML code from src/components/Navigation.astro -->
    <Header />  
<h1>About</h1>
        <p>Here are some facts about me:</p>
        <ul>
            <li>My name is {identity.firstName}.</li>
            <li>I live in {identity.country}.</li>
            {identity.hobbies.length >= 2 &&
            <li>Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[2]}.</li>}
        </ul>

        <p>My skills are:</p>
        <ul>
            {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>
    <Footer />
    </body>

</html>
